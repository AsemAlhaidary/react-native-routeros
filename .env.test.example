# RouterOS integration test environment — EXAMPLE template
#
# Copy this file to `.env.test` and fill in REAL values for your lab routers.
# `.env.test` is gitignored — NEVER commit real credentials or lab IPs.
#
# SAFETY (T-07-03): point these ONLY at lab devices on a private subnet. The
# integration tests write to the configured routers and sweep entities with the
# ROUTEROS_PREFIX below — do not point them at production equipment.

# v6 router (plain TCP, standard API port 8728)
ROUTEROS_V6_HOST=192.168.187.128
ROUTEROS_V6_PORT=8728

# v7 router — 8175 is a NON-STANDARD API port (custom /ip service or NAT
# forward; 8728/8729 are closed on this host). CONFIRM this is a RouterOS API
# service before running, and adjust if it is not.
ROUTEROS_V7_HOST=192.168.187.130
ROUTEROS_V7_PORT=8175

# Shared lab credentials (admin / CHANGE_ME are placeholders)
ROUTEROS_USER=admin
ROUTEROS_PASSWORD=CHANGE_ME

# Unique prefix for entities created by CRUD tests + cleanup sweep
ROUTEROS_PREFIX=gsd-itest

# Optional: gate the whole integration run behind this flag in CI
ROUTEROS_INTEGRATION=1
