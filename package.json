{
  "name": "react-native-routeros",
  "version": "0.1.0",
  "description": "MikroTik RouterOS API client for React Native",
  "main": "./lib/commonjs/index.js",
  "module": "./lib/module/index.js",
  "types": "./lib/typescript/module/index.d.ts",
  "source": "./src/index.ts",
  "react-native": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./lib/typescript/module/index.d.ts",
      "react-native": "./src/index.ts",
      "import": "./lib/module/index.js",
      "require": "./lib/commonjs/index.js"
    }
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "commonjs",
        {
          "esm": true
        }
      ],
      "typescript"
    ]
  },
  "license": "MIT",
  "keywords": [
    "routeros",
    "mikrotik",
    "react-native"
  ],
  "files": [
    "lib",
    "src",
    "app.plugin.js",
    "plugin/build"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "build": "bob build"
  },
  "devDependencies": {
    "@types/debug": "^4.1",
    "@types/events": "^3.0.3",
    "@types/jest": "^30.0.0",
    "jest": "^30.0.0",
    "react-native-builder-bob": "^0.43.0",
    "ts-jest": "^29.0.0",
    "typescript": "~5.9.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/src"
    ]
  },
  "dependencies": {
    "debug": "^4.4.3",
    "events": "^3.3.0",
    "js-md5": "^0.9.2",
    "react-native-tcp-socket": "^6.4.2"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*",
    "react-native-tcp-socket": "^6.4.2"
  }
}
